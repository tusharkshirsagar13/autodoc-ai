# ============================================================================
# AutoDoc AI configuration — copy this file to `.env` and edit as needed.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
# Never commit your real .env file. No real keys belong in this example.
# ============================================================================

# ---- Language model (optional) ---------------------------------------------
# none      = retrieval-only mode (no AI answers; everything else works)
# ollama    = local Ollama server (no data leaves your computer)
# openai    = OpenAI API, or any OpenAI-compatible server via LLM_BASE_URL
# anthropic = Anthropic API
LLM_PROVIDER=none
# Exact model identifier for the provider, e.g. an Ollama tag like llama3.1:8b.
# For hosted APIs, look up current model names in the provider's documentation.
LLM_MODEL=
# Optional: OpenAI-compatible local server (LM Studio, llama.cpp, vLLM), e.g. http://localhost:1234/v1
LLM_BASE_URL=
OLLAMA_HOST=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=60

# API keys — only needed for hosted providers. Leave empty otherwise.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Embeddings and retrieval -----------------------------------------------
# sentence-transformers (semantic; downloads the model once, ~130 MB) or
# hashing (offline lexical fallback, lower quality, no download)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
HYBRID_KEYWORD_WEIGHT=0.35
# Minimum hybrid relevance score for a passage to count as evidence
MIN_RELEVANCE_SCORE=0.35
MIN_RELEVANCE_SCORE_HASHING=0.15
MAX_CONTEXT_CHARS=12000

# ---- OCR (scanned PDFs) ------------------------------------------------------
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=200
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
LOW_TEXT_THRESHOLD=40

# ---- Storage and safeguards ----------------------------------------------------
# Defaults are the data/, uploads/ and chroma_db/ folders in the project.
AUTODOC_DATA_DIR=
AUTODOC_UPLOAD_DIR=
AUTODOC_CHROMA_DIR=
AUTODOC_MAX_UPLOAD_MB=50
AUTODOC_MAX_PAGES=1500
AUTODOC_MAX_DOCUMENTS=100

LOG_LEVEL=INFO
